# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-me-with-a-random-local-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Deployment security (enable after confirming HTTPS is configured end-to-end)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# Enable these only when every subdomain supports HTTPS and preload is intended.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_TRUST_X_FORWARDED_PROTO=False
DJANGO_SESSION_COOKIE_AGE=3600
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=True
DJANGO_PASSWORD_RESET_TIMEOUT=3600

# Database (leave blank to use SQLite in development)
DATABASE_URL=
DJANGO_CONN_MAX_AGE=600
DJANGO_DB_SSLMODE=prefer
# Used only by compose.preview.yaml; replace the password on the server.
POSTGRES_DB=emvera
POSTGRES_USER=emvera
POSTGRES_PASSWORD=replace-me-for-preview-only

# Email (for password reset / notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Emvera <noreply@example.com>
SERVER_EMAIL=Emvera Errors <errors@example.com>
# Development only. Never enable where logs leave your machine.
DJANGO_ALLOW_CONSOLE_EMAIL=False

# Plaid API (for bank account integration)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_REDIRECT_URI=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLAID_TOKEN_ENCRYPTION_KEY=
# Comma-separated old Fernet keys, used only while rotating stored tokens.
PLAID_TOKEN_ENCRYPTION_PREVIOUS_KEYS=

# Optional SMS reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Container/runtime tuning
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
LOG_LEVEL=INFO
