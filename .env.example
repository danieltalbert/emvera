# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Core Django (DJANGO_SECRET_KEY is required) ---
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Emvera uses SQLite by default; no configuration is needed here.
# To use PostgreSQL, wire it into core/settings.py (see DEPLOYMENT.md).

# --- Email ---
# If EMAIL_HOST is blank, email is printed to the console (dev mode).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Emvera <noreply@emvera.local>

# --- SMS reminders (Twilio; optional) ---
# All three must be set for SMS payment reminders to be sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Plaid bank integration (optional) ---
# Bank linking is only enabled when PLAID_CLIENT_ID is set.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- Alpaca (optional): live market data + paper trading ---
# Enables live price refresh (data_integration/pricing.py) and the paper_trading
# simulator. Needs only Emvera's own keys (no end-user account). ALPACA_PAPER
# defaults to True so orders can never accidentally hit a live-money account.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=True

# --- SnapTrade (optional): link an EXISTING brokerage ---
# The "Plaid for brokerages." Enables reading real holdings from a user's
# Robinhood / Schwab / Fidelity / etc. (data_integration/snaptrade_client.py).
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
