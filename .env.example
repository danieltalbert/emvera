# Copy this file to .env and fill in your values.
# Never commit .env to version control.

DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Deployment security (enable after confirming HTTPS is configured end-to-end)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Enable these only when every subdomain supports HTTPS and preload is intended.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Database (leave blank to use SQLite in development)
DATABASE_URL=

# Email (for password reset / notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Plaid API (for bank account integration)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
